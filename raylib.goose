extern fn rlReadShaderBuffer(id: u32, dest: u8&, count: u32, offset: u32);
extern fn rlCopyShaderBuffer(destId: u32, srcId: u32, destOffset: u32, srcOffset: u32, count: u32);
extern fn rlGetShaderBufferSize(id: u32) -> u32;
extern fn rlBindImageTexture(id: u32, index: u32, format: i32, readonly: bool);
extern fn rlGetMatrixModelview() -> Matrix;
extern fn rlGetMatrixProjection() -> Matrix;
extern fn rlGetMatrixTransform() -> Matrix;
extern fn rlGetMatrixProjectionStereo(eye: i32) -> Matrix;
extern fn rlGetMatrixViewOffsetStereo(eye: i32) -> Matrix;
extern fn rlSetMatrixProjection(proj: Matrix);
extern fn rlSetMatrixModelview(view: Matrix);
extern fn rlSetMatrixProjectionStereo(right: Matrix, left: Matrix);
extern fn rlSetMatrixViewOffsetStereo(right: Matrix, left: Matrix);
extern fn rlLoadDrawCube();
extern fn rlLoadDrawQuad();

// raylib's two variadic functions cannot be bound; these fixed-arity shims
// cover the common cases. Use Goose's own str(...) for formatted text.
extern fn rg_trace_log(level: i32, text: const u8&) = "rg_trace_log";
fn trace_log(level: i32, text: const u8&) { rg_trace_log(level, text); }

// ------------------------------ ergonomics
// raylib wants NUL-terminated C strings. These overloads of the raylib names
// take a Goose slice and put the terminator right after the call, so
// `DrawText("hi", 10, 10, 20, WHITE)` and `DrawText(t[0], ...)` both work.

extern fn rg_load_font_path(path: const u8&, size: i32) -> Font = "rg_load_font_path";

fn InitWindow(width: i32, height: i32, title: const u8[:]) {
    let t = str(title, "\0");
    InitWindow(width, height, t[0]);
}
fn DrawText(text: const u8[:], x: i32, y: i32, size: i32, tint: Color) {
    let t = str(text, "\0");
    DrawText(t[0], x, y, size, tint);
}
fn DrawTextEx(font: Font, text: const u8[:], position: Vector2, size: f32, spacing: f32, tint: Color) {
    let t = str(text, "\0");
    DrawTextEx(font, t[0], position, size, spacing, tint);
}
fn MeasureText(text: const u8[:], size: i32) -> i32 {
    let t = str(text, "\0");
    return MeasureText(t[0], size);
}
fn MeasureTextEx(font: Font, text: const u8[:], size: f32, spacing: f32) -> Vector2 {
    let t = str(text, "\0");
    return MeasureTextEx(font, t[0], size, spacing);
}
fn LoadTexture(path: const u8[:]) -> Texture {
    let t = str(path, "\0");
    return LoadTexture(t[0]);
}
fn LoadImage(path: const u8[:]) -> Image {
    let t = str(path, "\0");
    return LoadImage(t[0]);
}
fn LoadFont(path: const u8[:], fontSize: i32) -> Font {
    let t = str(path, "\0");
    return rg_load_font_path(t[0], fontSize);
}
fn LoadSound(path: const u8[:]) -> Sound {
    let t = str(path, "\0");
    return LoadSound(t[0]);
}
fn LoadMusicStream(path: const u8[:]) -> Music {
    let t = str(path, "\0");
    return LoadMusicStream(t[0]);
}

